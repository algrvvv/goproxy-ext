{
  "manifest_version": 3,
  "name": "GoProxy Connector",
  "version": "1.1",
  "permissions": [
    "proxy",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [ "*://*/*" ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
